# MR Computer Webshop – miljøvariabler
# Kopiér til .env.local og udfyld ved behov

# QuickPay (https://manage.quickpay.net)
# API-nøgle: Settings > Users > [system user] > API key
QUICKPAY_API_KEY=

# Privat nøgle til callback/webhook: Settings > Integration > Private key
QUICKPAY_PRIVATE_KEY=

# Admin login
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Site URL (bruges til metadata, sitemap, checkout redirects og produkt-API)
# Lokal: http://localhost:3000
# Production: https://mrcomputer.dk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fremtidigt produktfeed
# PRODUCT_FEED_URL=
